---
import type { Photo } from '../lib/media';
import { rowHeight, ratio, GRID } from '../lib/layout';
import '../styles/photo-grid.css';
// Rangées justifiées : styles communs avec le back-office dans styles/photo-grid.css,
// réglages (hauteurs, colonnes) dans lib/layout.ts.
// « columns » règle la hauteur des rangées (plus de colonnes = photos plus petites).
interface Props { photos: Photo[]; label?: string; columns?: number }
const { photos, label = '', columns = GRID.gallery } = Astro.props;
---
{photos.length > 0 && (
  <div class="pgrid grid" style={`--rh-n:${rowHeight(columns)}`} data-lightbox>
    {photos.map((p, i) => (
      <a class="ptile tile" href={p.src} data-index={i} style={`--r:${ratio(p).toFixed(4)}`}>
        <img src={p.thumb} alt={p.alt || `${label}, photo ${i + 1}`} width={p.w} height={p.h} loading="lazy" decoding="async" />
      </a>
    ))}
  </div>
)}

<style>
  .tile { background: var(--raised); cursor: zoom-in; }
  .tile img { transition: opacity .6s var(--ease-out); }
  .grid:hover .tile img { opacity: .82; }
  .grid .tile:hover img { opacity: 1; }
</style>

<script>
  import { initLightbox } from '../lib/lightbox';
  document.querySelectorAll<HTMLElement>('[data-lightbox]').forEach(initLightbox);
</script>
